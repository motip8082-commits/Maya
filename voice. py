import pyttsx3
import speech_recognition as sr

# --- MAYA KI AWAZ ---
engine = pyttsx3.init()
engine.setProperty('rate', 150)  # Bolne ki speed
engine.setProperty('volume', 1.0)  # Awaz kitni tez

# Female voice set karne ki koshish
voices = engine.getProperty('voices')
for voice in voices:
    if "female" in voice.name.lower() or "zira" in voice.name.lower():
        engine.setProperty('voice', voice.id)
        break

def speak(text):
    """MAYA bolegi"""
    print(f"MAYA: {text}")
    engine.say(text)
    engine.runAndWait()

def listen():
    """MAYA sunegi"""
    r = sr.Recognizer()
    with sr.Microphone() as source:
        print("MAYA sun rahi hai... bolo")
        r.adjust_for_ambient_noise(source)
        audio = r.listen(source, timeout=5)
    try:
        text = r.recognize_google(audio, language='hi-IN')
        print(f"Tum: {text}")
        return text.lower()
    except:
        speak("Sunai nahi diya, phir se bolo na?")
        return ""

# Test karne ke liye
if __name__ == "__main__":
    speak("Hii... main MAYA hu. Bolo kya kar rahe ho?")
